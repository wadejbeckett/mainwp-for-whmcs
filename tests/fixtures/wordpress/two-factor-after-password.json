  "body": "<!DOCTYPE html>\n\t<html lang=\"en-US\">\n\t<head>\n\t<meta http-equiv=\"Content-Type\" content=\"text/html; charset=UTF-8\" />\n\t<title>Log In &lsaquo; Bench client site &#8212; WordPress</title>\n\t<meta name='robots' content='max-image-preview:large, noindex, noarchive' />\n<link rel='stylesheet' href='https://mainwp-bench-site.test/wp-admin/load-styles.php?c=0&amp;dir=ltr&amp;load%5Bchunk_0%5D=dashicons,buttons,forms,l10n,wp-base-styles,wp-tooltip,login&amp;ver=7.1.4' media='all' />\n<link rel='stylesheet' id='user-edit-2fa-css' href='https://mainwp-bench-site.test/wp-content/plugins/two-factor/user-edit.css?ver=0.17.0' media='all' />\n\t<meta name='referrer' content='strict-origin-when-cross-origin' />\n\t\t<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n\t\t</head>\n\t<body class=\"login no-js login-action-login wp-core-ui admin-color-modern locale-en-us\">\n\t<script>\ndocument.body.className = document.body.className.replace('no-js','js');\n</script>\n\n\t\t\t\t<h1 class=\"screen-reader-text\">Log In</h1>\n\t\t\t<div id=\"login\">\n\t\t<h1 role=\"presentation\" class=\"wp-login-logo\"><a href=\"https://wordpress.org/\">Powered by WordPress</a></h1>\n\t\n\t\t<form name=\"validate_2fa_form\" id=\"loginform\" action=\"https://mainwp-bench-site.test/wp-login.php?action=validate_2fa\" method=\"post\" autocomplete=\"off\">\n\t\t\t\t<input type=\"hidden\" name=\"provider\"      id=\"provider\"      value=\"Two_Factor_Email\">\n\t\t\t\t<input type=\"hidden\" name=\"wp-auth-id\"    id=\"wp-auth-id\"    value=\"1\">\n\t\t\t\t<input type=\"hidden\" name=\"wp-auth-nonce\" id=\"wp-auth-nonce\" value=\"[bench]\">\n\t\t\t\t\t\t\t\t\t<input type=\"hidden\" name=\"redirect_to\" value=\"https://mainwp-bench-site.test/wp-admin/\">\n\t\t\t\t\t\t\t\t<input type=\"hidden\" name=\"rememberme\"    id=\"rememberme\"    value=\"0\">\n\n\t\t\t\t\t\t\t\t<p class=\"two-factor-prompt\">A verification code has been sent to the email address associated with your account.</p>\n\t\t\t\t<p>\n\t\t\t<label for=\"authcode\">Verification Code:</label>\n\t\t\t<input type=\"text\" inputmode=\"numeric\" name=\"two-factor-email-code\" id=\"authcode\" class=\"input authcode\" value=\"\" size=\"20\" pattern=\"[0-9 ]*\" autocomplete=\"one-time-code\" placeholder=\"XXXXXXXX\" data-digits=\"8\">\n\t\t</p>\n\t\t\t\t<p class=\"submit\"><input type=\"submit\" name=\"submit\" id=\"submit\" class=\"button button-primary\" value=\"Verify\"  /></p>\t\t<p class=\"two-factor-email-resend\">\n\t\t\t<input type=\"submit\" class=\"button\" name=\"two-factor-email-code-resend\" value=\"Resend Code\">\n\t\t</p>\n\t\t\t\t\t\t</form>\n\n\t\t\n\t\t\n\t\t\t\t\t\t<p id=\"backtoblog\">\n\t\t\t<a href=\"https://mainwp-bench-site.test/\">&larr; Go to Bench client site</a>\t\t</p>\n\t\t\t</div>\n\t\n\t<script id=\"two-factor-login-js\" src=\"https://mainwp-bench-site.test/wp-content/plugins/two-factor/providers/js/two-factor-login.js?ver=0.17.0\"></script>\n<script id=\"two-factor-login-authcode-js\" src=\"https://mainwp-bench-site.test/wp-content/plugins/two-factor/providers/js/two-factor-login-authcode.js?ver=0.17.0\"></script>\n\t</body>\n\t</html>\n\t\t\t"
}
